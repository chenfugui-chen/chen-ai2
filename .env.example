# 复制本文件为 .env，填入你自己的真实配置后使用
# 注意：.env 已被 .gitignore 忽略，不会被提交到仓库

# DeepSeek 大模型配置（在 https://platform.deepseek.com 获取 API Key）
DEEPSEEK_API_KEY=你的_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# MySQL 会话存储配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=你的_mysql_密码
MYSQL_DB=ai_rag
