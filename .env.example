# 复制本文件为 .env，填入你自己的真实配置后使用
# 注意：.env 已被 .gitignore 忽略，不会被提交到仓库

# ===== DeepSeek 大模型（在 https://platform.deepseek.com 获取 API Key）=====
DEEPSEEK_API_KEY=你的_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== MySQL 会话存储 =====
# docker compose 部署：MYSQL_HOST 会被 compose 覆盖为服务名 mysql，这里保持 127.0.0.1 即可
# 本地直接运行（不用 docker）：保持 127.0.0.1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=ai_rag
# 应用连接数据库使用的账号（docker compose 首次启动会自动创建并授权到 ai_rag）
MYSQL_USER=airag
MYSQL_PASSWORD=换成你自己的数据库强密码
# 仅 docker compose 内置 MySQL 需要：root 密码（只在容器内部使用，不提供给应用）
MYSQL_ROOT_PASSWORD=换成你自己的_root强密码
